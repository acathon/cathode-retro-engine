{
  "name": "cathode-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/platform-web --out-dir ../../packages/sdk/wasm --target web",
    "build:wasm:dev": "wasm-pack build crates/platform-web --out-dir ../../packages/sdk/wasm --target web --dev",
    "build:sdk": "npm run build --workspace=@cathode/sdk",
    "build:cli": "npm run build --workspace=@cathode/cli",
    "build:editor": "npm run build --workspace=@cathode/editor",
    "build:all": "npm run build:wasm && npm run build:sdk && npm run build:cli",
    "dev:editor": "npm run dev --workspace=@cathode/editor",
    "dev:demo": "npm run dev --workspace=@cathode/demo-game",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:studio": "npm run dev --workspace=@cathode/studio",
    "build:site": "node scripts/build-site.mjs",
    "build:dist": "node scripts/build-site.mjs && node scripts/build-dist.mjs",
    "gen:font": "node scripts/gen-font-glyphs.mjs"
  },
  "devDependencies": {
    "marked": "^14.1.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
