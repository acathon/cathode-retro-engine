{
  "name": "retro-engine-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/platform-web --target web",
    "build:wasm:dev": "wasm-pack build crates/platform-web --target web --dev",
    "build:sdk": "npm run build --workspace=@retro-engine/sdk",
    "build:cli": "npm run build --workspace=@retro-engine/cli",
    "build:editor": "npm run build --workspace=@retro-engine/editor",
    "build:all": "npm run build:wasm && npm run build:sdk && npm run build:cli",
    "dev:editor": "npm run dev --workspace=@retro-engine/editor",
    "dev:demo": "npm run dev --workspace=@retro-engine/demo-game",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
